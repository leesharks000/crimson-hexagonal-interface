{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!rooms/|navigation/|assets/|queue/|map/|works/|snapshots/|machine/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "crimsonhexagonal.org"
        }
      ],
      "destination": "https://www.crimsonhexagonal.org/:path*",
      "permanent": true
    }
  ]
}